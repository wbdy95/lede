#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1

start_service() {
	config_load picoclaw
	local enabled
	config_get_bool enabled general enabled 0

	[ "$enabled" -eq 0 ] && return 1

	# Ensure config exists
	[ -f /etc/picoclaw/config.yml ] || /usr/bin/picoclaw-generate-config

	procd_open_instance
	procd_set_command /usr/bin/picoclaw-launcher -config /etc/picoclaw/config.yml -public
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}

	procd_add_jail picoclaw ubus
	procd_add_jail_mount /etc/picoclaw r
	procd_add_jail_mount /var/log rw
	procd_add_jail_mount /etc/ca-certificates r

	# Network trigger - restart on LAN interface change
	local allowed_lan
	config_get_bool allowed_lan security allowed_lan 1
	if [ "$allowed_lan" -eq 1 ]; then
		procd_add_interface_trigger "lan" "restart"
	fi

	procd_close_instance
}

stop_service() {
	procd_kill picoclaw
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "picoclaw"
}
