config squid 'squid'
	option enabled '0'
	option config_file '/etc/squid/squid.conf'
	option http_port '3128'
	option coredump_dir '/tmp/squid'
	option visible_hostname 'OpenWrt'
	option mime_table '/etc/squid/mime.conf'
	#option http_port_options ''
	#option ssldb '/tmp/squid/ssldb'
	#option ssldb_options '-M 4MB'

	# Transparent proxy settings
	option intercept_enabled '0'
	option intercept_port '3129'
	option intercept_all_lan '0'
	# Specific IPs to intercept (when intercept_all_lan is 0)
	#list intercept_ip '192.168.1.100'
	#list intercept_ip '192.168.1.101'

	# Cache settings
	option cache_mem '64'
	option maximum_object_size_in_memory '512'
	option cache_dir_size '100'
	option maximum_object_size '4096'
	option minimum_object_size '0'

	# Logging
	option access_log '0'
	option cache_log '0'
	option log_dir '/tmp/squid'

	# Timeouts
	option connect_timeout '60'
	option read_timeout '15'
	option request_timeout '5'
	option client_lifetime '1440'

	# DNS
	option dns_v4_first '1'

	# Advanced
	option pinger_enable 'off'
	option forwarded_for 'off'
	option via 'off'

# ACL definitions
config acl
	option name 'localnet'
	option type 'src'
	list entry '10.0.0.0/8'
	list entry '172.16.0.0/12'
	list entry '192.168.0.0/16'

config acl
	option name 'allowed_sites'
	option type 'dstdomain'
	option enabled '0'
	# list entry '.example.com'

config acl
	option name 'blocked_sites'
	option type 'dstdomain'
	option enabled '0'
	# list entry '.blocked.com'

# Access rules
config http_access
	option action 'allow'
	option acl 'localnet'
	option enabled '1'
	option order '10'

config http_access
	option action 'allow'
	option acl 'localhost'
	option enabled '1'
	option order '20'

config http_access
	option action 'deny'
	option acl 'all'
	option enabled '1'
	option order '99'
