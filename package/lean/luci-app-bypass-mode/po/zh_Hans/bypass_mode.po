msgid "Bypass Router Mode"
msgstr "旁路由模式"

msgid "Configure single NIC bypass router mode with IPv4 and IPv6 dual-stack support. This mode allows your device to act as a secondary router/gateway in an existing network."
msgstr "配置单网口旁路由模式，支持 IPv4 和 IPv6 双栈。此模式允许您的设备在现有网络中充当辅助路由器/网关。"

msgid "Service Status"
msgstr "服务状态"

msgid "Basic Settings"
msgstr "基本设置"

msgid "General"
msgstr "常规"

msgid "IPv4 Settings"
msgstr "IPv4 设置"

msgid "IPv6 Settings"
msgstr "IPv6 设置"

msgid "Firewall"
msgstr "防火墙"

msgid "Advanced"
msgstr "高级"

msgid "Enable Bypass Mode"
msgstr "启用旁路由模式"

msgid "Enable bypass router mode. This will modify your network configuration."
msgstr "启用旁路由模式。这将修改您的网络配置。"

msgid "Network Interface"
msgstr "网络接口"

msgid "Physical network interface to use (usually eth0 for single NIC)"
msgstr "要使用的物理网络接口（单网口通常为 eth0）"

