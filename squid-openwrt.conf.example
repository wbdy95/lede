# 优化的 Squid 配置示例
# 适用于 OpenWrt 路由器环境
# 放置在 /etc/squid/squid-openwrt.conf

# 基础网络配置
http_port 3128
icp_port 3130

# 访问日志
access_log /var/log/squid/access.log squid
cache_log /var/log/squid/cache.log
pid_filename /var/run/squid.pid

# 缓存配置（针对低配置硬件优化）
cache_dir ufs /var/cache/squid 100 16 256
cache_mem 64 MB
maximum_object_size_in_memory 512 KB

# 缓存替换策略
cache_replacement_policy heap LFUDA
memory_replacement_policy heap GDSF

# 对象大小限制
maximum_object_size 512 MB
minimum_object_size 0 KB

# 刷新模式（缓存有效期）
refresh_pattern ^ftp:           1440    20%     10080
refresh_pattern -i (/cgi-bin/|\?)  0   0%      0
refresh_pattern -i \.(jpg|jpeg|png|gif|css|js|swf|flv|ico)$  10080  80%  43200
refresh_pattern -i \.(iso|mpeg|avi|bin|exe|zip|gz|tgz|rar|pdf)$  1440  80%  10080
refresh_pattern .               0       20%     4320

# 连接配置
server_persistent_connections on
client_persistent_connections on
http_persistent_connections on
idle_timeout 15 seconds

# 延迟池（流量管理）
# 例如：限制下载速度为 1MB/s
# delay_pools 1
# delay_class 1 1
# delay_access 1 allow all
# delay_parameters 1 -1/-1

# 访问控制列表 (ACL)
acl all src 0.0.0.0/0.0.0.0
acl localhost src 127.0.0.1/32
acl localnet src 10.0.0.0/8
acl localnet src 172.16.0.0/12
acl localnet src 192.168.0.0/16
acl localnet src 169.254.0.0/16
acl SSL_ports port 443
acl Safe_ports port 80 21 70 210 280 488 591 777 8080 8888 9898
acl CONNECT method CONNECT

# 访问规则
http_access allow localhost
http_access allow localnet
http_access deny !Safe_ports
http_access deny CONNECT !SSL_ports
http_access deny all

# 允许管理员访问
acl manager proto cache_object
http_access allow manager localhost

# 网络地址转换
request_header_access X-Forwarded-For deny all
request_header_access Via deny all
request_header_access Cache-Control deny all

# 可见主机名
visible_hostname OpenWrt-Squid-Proxy

# MIME 类型表
mime_table /etc/squid/mime.conf

# DNS 配置
dns_nameservers 8.8.8.8 8.8.4.4
name_resolve_attempts 2
dns_retransmit_interval 5 seconds

# 错误页面目录
error_directory /usr/share/squid/errors/templates

# 核心转储
coredump_dir /tmp/squid

# 日志格式定制
logformat squid %ts.%03tu %6tr %>a %Ss/%03Hs %<st %rm %ru %un %Sh/%<A %mt

# 性能调优
cache_swap_log_max_size 16 MB
netdb_filename /var/cache/squid/netdb.state

# ACL 针对特定资源的缓存规则示例
acl images urlpath_regex -i \.(jpg|jpeg|png|gif|svg|webp)$
acl documents urlpath_regex -i \.(pdf|doc|docx|xls|xlsx|ppt|pptx)$
acl css_js urlpath_regex -i \.(css|js)$
acl html_files urlpath_regex -i \.(html|htm)$

# 对不同类型文件的缓存策略
cache allow images
cache allow documents
cache allow css_js
cache allow html_files
cache deny all

# 压缩配置（如果编译时启用）
# gzip_program /usr/bin/gzip
# compress_program /usr/bin/gzip -4

# 内存限制（根据实际硬件调整）
# 对于内存较小的设备，减小这些值
maximum_filedescriptors 1024
max_open_disk_fds 0

# 定期清理任务
cleanup_interval 60 seconds
store_clean_interval 10 minutes

# 安全相关
request_body_max_size 0 KB
reply_body_max_size 0 KB

# 启用 SNMP（可选）
# snmp_port 3401
# snmp_access allow public localhost

# 扩展选项（取决于编译时的配置）
# ssl_bump none all
# logfile_rotate 10
